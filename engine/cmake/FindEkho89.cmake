foreach(path "${EKHO_SOURCE_DIR}/src/ekho.h" "${EKHO_SOURCE_DIR}/sonic/sonic.h"
             "${EKHO_BUILD_DIR}/config.h" "${EKHO_BUILD_DIR}/libekho.a")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing ${path}. Build Ekho v8.9 with -fPIC first; see README.md.")
    endif()
endforeach()
file(READ "${EKHO_SOURCE_DIR}/src/libekho_impl.cpp" ekho_impl)
if(NOT ekho_impl MATCHES "audioplay_ekho89_patch_level[^}]*return 2;")
    message(FATAL_ERROR "Apply scripts/patch_ekho89.py to Ekho v8.9, then rebuild libekho.a with -fPIC. See README.md.")
endif()
file(READ "${EKHO_BUILD_DIR}/config.h" ekho_config)
if(NOT ekho_config MATCHES "#define PACKAGE_VERSION[ \t]+\"8\\.9\"")
    message(FATAL_ERROR "This package requires Ekho v8.9 exactly (check ${EKHO_BUILD_DIR}/config.h).")
endif()
foreach(feature ENABLE_FESTIVAL ENABLE_MUSICXML ENABLE_FRISO ENABLE_SOUNDTOUCH HAVE_MP3LAME HAVE_SOXR HAVE_LIBSOXR)
    if(ekho_config MATCHES "(^|\n)[ \t]*#define[ \t]+${feature}([ \t\r\n]|$)")
        message(FATAL_ERROR "Ekho optional feature ${feature} is enabled. Use the minimal build in README.md.")
    endif()
endforeach()
find_path(PULSE_INCLUDE_DIR pulse/simple.h)
find_path(SNDFILE_INCLUDE_DIR sndfile.h)
find_path(ESPEAK_INCLUDE_DIR espeak-ng/speak_lib.h)
find_path(MPG123_INCLUDE_DIR mpg123.h PATH_SUFFIXES x86_64-linux-gnu aarch64-linux-gnu)
find_library(PULSE_SIMPLE_LIBRARY NAMES pulse-simple)
find_library(PULSE_LIBRARY NAMES pulse)
find_library(SNDFILE_LIBRARY NAMES sndfile)
find_library(ESPEAK_LIBRARY NAMES espeak-ng)
find_library(MPG123_LIBRARY NAMES mpg123)
foreach(variable PULSE_INCLUDE_DIR SNDFILE_INCLUDE_DIR ESPEAK_INCLUDE_DIR MPG123_INCLUDE_DIR
                 PULSE_SIMPLE_LIBRARY PULSE_LIBRARY SNDFILE_LIBRARY ESPEAK_LIBRARY MPG123_LIBRARY)
    if(NOT ${variable})
        message(FATAL_ERROR "Missing ${variable}. Install the development packages listed in README.md.")
    endif()
endforeach()
add_library(Ekho89 STATIC IMPORTED GLOBAL)
set_target_properties(Ekho89 PROPERTIES
    IMPORTED_LOCATION "${EKHO_BUILD_DIR}/libekho.a"
    INTERFACE_INCLUDE_DIRECTORIES "${EKHO_SOURCE_DIR}/src;${EKHO_SOURCE_DIR}/sonic;${EKHO_SOURCE_DIR}/utfcpp/source;${EKHO_BUILD_DIR};${PULSE_INCLUDE_DIR};${SNDFILE_INCLUDE_DIR};${ESPEAK_INCLUDE_DIR};${MPG123_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "${PULSE_SIMPLE_LIBRARY};${PULSE_LIBRARY};${SNDFILE_LIBRARY};${ESPEAK_LIBRARY};${MPG123_LIBRARY};Threads::Threads")
